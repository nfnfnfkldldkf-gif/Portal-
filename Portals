coordBtn.MouseButton1Click:Connect(function()
	local r = hrp()
	if not r then return end
	local a, b, c = coordBox.Text:match("([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)")
	if not a then a, b, c = coordBox.Text:match("([%-%.%d]+)%s+([%-%.%d]+)%s+([%-%.%d]+)") end
	a, b, c = tonumber(a), tonumber(b), tonumber(c)
	if a and b and c then r.CFrame = CFrame.new(a, b, c) end
end)

copyBtn.MouseButton1Click:Connect(function()
	local r = hrp()
	if r then
		local p = r.Position
		coordBox.Text = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
	end
end)

idBtn.MouseButton1Click:Connect(function()
